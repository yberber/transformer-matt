    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
